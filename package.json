{
  "name": "grub",
  "version": "0.1.1",
  "description": "A free, open-source Mac cleaner with a live health dashboard, disk map, menu bar stats, startup control and updates.",
  "main": "src/main.js",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper || true",
    "icon": "sh scripts/icon.sh",
    "dist:notarized": "npm run package && sh scripts/make-dmg.sh && sh scripts/notarize-dmg.sh",
    "release": "sh scripts/release.sh",
    "package": "node scripts/package-signed.js",
    "dist": "npm run package && sh scripts/make-dmg.sh"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
